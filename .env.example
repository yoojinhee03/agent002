# ============================================================
# Database
# ============================================================
POSTGRES_DB=agentstudio
POSTGRES_USER=agentstudio
POSTGRES_PASSWORD=agentstudio
DATABASE_URL=postgresql://agentstudio:eldnlrtm!23@localhost:5433/agentstudio

# ============================================================
# Redis
# ============================================================
REDIS_PASSWORD=eldnlrtm!23
REDIS_HOST=localhost
REDIS_PORT=6380

# ============================================================
# Auth
# ============================================================
JWT_SECRET=your-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars

# ============================================================
# Encryption (AES-256 for provider API keys)
# ============================================================
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Phase 10-3 — 사용자 자격증명(UserCredential.value_enc) 전용 키.
# 비워두면 ENCRYPTION_KEY 가 fallback 으로 사용됨.
# 발급: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# ============================================================
# Internal Service Communication
# ============================================================
INTERNAL_SERVICE_KEY=your-internal-service-secret-here

# ============================================================
# API Service
# ============================================================
RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_MS=180000
LOG_QUEUE_CONCURRENCY=5
CACHE_TTL_SECONDS=300

# ============================================================
# URLs (internal docker-compose communication)
# ============================================================
API_URL=http://api:4000
API_SERVICE_URL=http://api-service:4100

# ============================================================
# Web App (Next.js public env vars)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_SERVICE_URL=http://localhost:4100

# NAVER WORKS Bot callback URL 의 공개 베이스(외부에서 도달 가능한 NestJS 호스트).
# 미지정 시 NEXT_PUBLIC_API_URL 폴백. 통합 설정 화면에서 callback URL 표시용.
# 예: https://api.example.com  (실제 callback 은 `${BASE}/api/webhooks/naver-works/{botId}`)
NEXT_PUBLIC_NAVER_WORKS_CALLBACK_BASE=

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=https://your-domain.com

# ============================================================
# Provider API Keys (fallback, optional)
# DB keys take priority
# ============================================================
# ============================================================
# LangChain / LangSmith Tracing
# ============================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=AgentStudio
