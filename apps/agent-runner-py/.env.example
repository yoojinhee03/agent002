PORT=4300
DATABASE_URL=postgresql://agentstudio:eldnlrtm!23@localhost:5433/agentstudio
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=eldnlrtm!23
INTERNAL_SERVICE_KEY=internal-service-key

# NestJS apps/api 호스트 — NAVER WORKS 1:1 응답을 reply endpoint 로 push 할 때 사용.
# settings.MANAGEMENT_API_URL 로 매핑됨. 기본값: http://localhost:28001
MANAGEMENT_API_URL=http://localhost:28001

# Phase 9 — 외부 client 채팅 namespace `/v1/chat` 활성화 토글.
# false 로 두면 외부 socket.io connect 가 거절되고 forward_* 가 모두 no-op (롤백 토글).
EXTERNAL_CHAT_ENABLED=true

# LangChain Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=AgentStudio-py

# OAuth MCP 표준 콜백 URL — sandbox 컨테이너 안의 MCP 가 provider 에 알릴 외부 URL.
# 운영에선 ecosystem.config.js runner.env 에서 도메인으로 override.
# 기본값: http://localhost:28003/oauth/callback
PUBLIC_OAUTH_CALLBACK_URL=http://localhost:28003/oauth/callback

# sandbox 컨테이너에 추가 bind mount 할 호스트 경로 목록.
# 형식: "<src>:<dst>[:<mode>],..." (mode 기본 ro)
# 호스트에도 같은 경로(또는 심볼릭 링크)가 있어야 list_tools 단계도 통과한다.
# 예: SANDBOX_EXTRA_MOUNTS=/Users/me/nworks:/opt/nworks:ro
SANDBOX_EXTRA_MOUNTS=
