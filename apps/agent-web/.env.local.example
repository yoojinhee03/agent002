# 로컬 개발용 환경변수. apps/agent-web/.env.local 로 복사 후 본인 환경에 맞게 수정.
# (이 파일은 git tracked, .env.local 은 untracked)
#
# Dev 서버 빌드 시에는 scripts/deploy-dev.sh 가 NEXT_PUBLIC_* 를 직접 export 하므로
# .env.local 의 값과 무관하다.

# 로컬 개발 (전체 로컬 스택):
NEXT_PUBLIC_API_URL=http://localhost:28001
NEXT_PUBLIC_RUNNER_URL=http://localhost:28003

# 외부 dev 서버 API 사용:
# NEXT_PUBLIC_API_URL=http://dweax.iptime.org:28001
# NEXT_PUBLIC_RUNNER_URL=http://dweax.iptime.org:28003
