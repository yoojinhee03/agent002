{
  "name": "@agent-studio/api",
  "version": "1.0.0",
  "private": true,
  "prisma": {
    "schema": "../../packages/database/prisma/schema.prisma",
    "seed": "node --import tsx/esm ../../packages/database/prisma/seed.ts 2>/dev/null || npx tsx ../../packages/database/prisma/seed.ts"
  },
  "scripts": {
    "build": "nest build",
    "predev": "npx --yes kill-port 28001",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "clean": "rm -rf dist .turbo",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=../../packages/database/prisma/schema.prisma",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema=../../packages/database/prisma/schema.prisma",
    "db:push": "dotenv -e ../../.env -- prisma db push --schema=../../packages/database/prisma/schema.prisma",
    "db:seed": "pnpm --filter @agent-studio/database db:seed",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema=../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@agent-studio/database": "workspace:*",
    "@agent-studio/shared": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.10.1",
    "@slack/bolt": "^4.7.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.0.1",
    "js-yaml": "^4.1.1",
    "openai": "^4.103.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.2",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.40",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/passport-jwt": "^4.0.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1"
  }
}
