{
  "name": "agent-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "prepare": "husky",
    "db:generate": "pnpm --filter @agent-studio/database db:generate",
    "db:push": "pnpm --filter @agent-studio/database db:push",
    "db:seed": "pnpm --filter @agent-studio/database db:seed",
    "db:migrate": "pnpm --filter @agent-studio/database db:migrate",
    "db:deploy": "pnpm --filter @agent-studio/database db:deploy",
    "db:studio": "pnpm --filter @agent-studio/database db:studio",
    "setup": "test -f .env || cp .env.example .env; docker compose up -d && pnpm install && pnpm --filter @agent-studio/database db:generate && pnpm --filter @agent-studio/database db:deploy",
    "sandbox:build": "docker build -t agentstudio-sandbox:0.1 apps/agent-runner-py/docker/sandbox"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.5.4"
  },
  "lint-staged": {
    "apps/agent-web/**/*.{ts,tsx}": "bash -c 'pnpm --filter @agent-studio/web lint --quiet'",
    "apps/api/src/**/*.ts": "bash -c 'pnpm --filter @agent-studio/api lint --quiet'",
    "packages/shared/**/*.ts": "bash -c 'pnpm --filter @agent-studio/shared lint --quiet'",
    "packages/database/**/*.ts": "bash -c 'pnpm --filter @agent-studio/database lint --quiet'"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt",
      "esbuild",
      "@nestjs/core"
    ]
  }
}
